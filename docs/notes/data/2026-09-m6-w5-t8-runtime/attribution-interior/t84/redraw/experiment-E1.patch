+    /// @brief Restores this result to the VALUE a default @ref SolveResult
+    ///        carries, without destroying the object.
+    ///
+    /// PER-CALL STATE, NOT A PER-CALL OBJECT (M6 W5 T8.9r-attrib4, experiment
+    /// E1). The engines hold a result member as the workspace of the call in
+    /// flight and it must start every call carrying nothing of the last one --
+    /// which `*this = SolveResult{}` also achieves, by destroying every buffer
+    /// the member owns and building a fresh empty one in its place. This
+    /// function states the same reset as an assignment per field, so the
+    /// containers that HAVE a capacity distinct from their size (the engine
+    /// layers' `std::vector` and `std::string` members) keep theirs across
+    /// calls. `Vec` is an Eigen dense block, which has no such distinction:
+    /// `resize(0)` frees its storage, and an empty block is the DECLARED
+    /// meaning of "unmeasured" for `ce`, `ci` and the multiplier blocks, so it
+    /// is the reset this contract requires whatever it costs.
+    void reset_for_call() {
+        status = SolveStatus::kNumericalError;
+        x.resize(0);
+        lambda_e.resize(0);
+        lambda_i.resize(0);
+        z.resize(0);
+        f = std::numeric_limits<double>::quiet_NaN();
+        stationarity = std::numeric_limits<double>::quiet_NaN();
+        feasibility_e = std::numeric_limits<double>::quiet_NaN();
+        feasibility_i = std::numeric_limits<double>::quiet_NaN();
+        complementarity = std::numeric_limits<double>::quiet_NaN();
+        ce.resize(0);
+        ci.resize(0);
+        iterations = 0;
+        wall_seconds = 0.0;
+        export_snapshot_.reset();
+    }
+
   protected:
     /// The snapshot @ref export_warm_start hands out; written by the engine at
     /// solve exit and by nothing else.
