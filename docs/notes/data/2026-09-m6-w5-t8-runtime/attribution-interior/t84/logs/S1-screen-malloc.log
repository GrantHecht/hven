ults {pf:,} sys {sy:.4f} user {us:.4f}" for l,pf,sy,us in row),           f" || fault step {row[1][1]/row[0][1]:.4f}  sys step {row[1][2]/row[0][2]:.4f}") PY' && pwd -P >| /tmp/claude-5cac-cwd
