diff -ruN measB/include/hven/detail/qp/walk/sizing_log.h measC/include/hven/detail/qp/walk/sizing_log.h
--- measB/include/hven/detail/qp/walk/sizing_log.h	1969-12-31 19:00:00.000000000 -0500
+++ measC/include/hven/detail/qp/walk/sizing_log.h	2026-11-21 04:45:51.646559837 -0500
@@ -0,0 +1,20 @@
+// SCRATCH ONLY (PF-2c sizing): env-gated event log; never committed to the library.
+#pragma once
+#include <cstdio>
+#include <cstdlib>
+namespace hven::detail::sizing {
+inline std::FILE *fp() {
+    static std::FILE *f = [] {
+        const char *p = std::getenv("HVEN_SIZING_LOG");
+        if (p == nullptr) {
+            return static_cast<std::FILE *>(nullptr);
+        }
+        std::FILE *g = std::fopen(p, "w");
+        if (g != nullptr) {
+            std::atexit([] { std::fflush(fp()); });
+        }
+        return g;
+    }();
+    return f;
+}
+} // namespace hven::detail::sizing
