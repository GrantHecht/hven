+// ---- PF-5 PROTOTYPE -------------------------------------------------------
+int pf5_cap() {
+    static const int cap = [] {
+        const char *e = std::getenv("HVEN_PF5_RETAIN");
+        return e != nullptr ? std::atoi(e) : 0;
+    }();
+    return cap;
+}
+struct Pf5Stats {
+    std::uint64_t analyses[3] = {0, 0, 0};     // fresh backend analyses, by role
+    std::uint64_t hits[3] = {0, 0, 0};         // retained session swapped in
+    std::uint64_t discards = 0;                // swapped-in session discarded on failure
+    std::uint64_t evictions = 0;
+    std::map<std::size_t, std::uint64_t> dist[3]; // LRU stack distance (1 = previous pattern), 0 = cold
+    ~Pf5Stats() {
+        if (std::getenv("HVEN_PF5_PROBE") == nullptr) {
+            return;
+        }
+        std::fprintf(stderr, "PF5 cap=%d discards=%llu evictions=%llu\n", pf5_cap(),
+                     (unsigned long long)discards, (unsigned long long)evictions);
+        for (int r = 0; r < 3; ++r) {
+            std::fprintf(stderr, "PF5R role=%d fresh=%llu hits=%llu", r,
+                         (unsigned long long)analyses[r], (unsigned long long)hits[r]);
+            for (const auto &[d, c] : dist[r]) {
+                std::fprintf(stderr, " d%zu=%llu", d, (unsigned long long)c);
+            }
+            std::fprintf(stderr, "\n");
+        }
+    }
+};
+Pf5Stats &pf5_stats() {
+    static Pf5Stats s;
+    return s;
+}
+void pf5_note(KktFactor &k, std::uint64_t pattern) {
+    auto &sh = k.pf5_shadow;
+    std::size_t d = 0;
+    for (std::size_t i = 0; i < sh.size(); ++i) {
+        if (sh[i] == pattern) {
+            d = i + 1;
+            sh.erase(sh.begin() + static_cast<std::ptrdiff_t>(i));
+            break;
+        }
+    }
+    sh.insert(sh.begin(), pattern);
+    ++pf5_stats().dist[k.pf5_role][d];
+}
+void pf5_carry(KktFactor &k, const hven::linear::SymmetricFactor &f, Index sign) {
+    const auto &c = f.counters();
+    k.carry_dense_factorize += sign * c.dense_factorize_count;
+    k.carry_dense_singular += sign * c.dense_singular_count;
+    k.carry_dense_flagged += sign * c.dense_flagged_count;
+    k.carry_dense_shift_refactor += sign * c.dense_shift_refactor_count;
+    k.carry_dense_retake += sign * c.dense_retake_count;
+}
+// Moves `incoming` into k.factor; the outgoing session (if analyzed) becomes
+// the most recently used retained entry, the LRU tail evicted past the cap.
+void pf5_install(KktFactor &k, std::unique_ptr<hven::linear::SymmetricFactor> incoming,
+                 std::uint64_t pattern) {
+    pf5_carry(k, *incoming, -1);
+    std::swap(k.factor, *incoming); // incoming now holds the outgoing session
+    pf5_carry(k, *incoming, +1);
+    if (k.analyzed) {
+        k.retained.insert(k.retained.begin(),
+                          KktFactor::RetainedAnalysis{k.analyzed_pattern, std::move(incoming)});
+        while (static_cast<int>(k.retained.size()) > pf5_cap()) {
+            k.retained.pop_back();
+            ++pf5_stats().evictions;
+        }
+    }
+    k.analyzed_pattern = pattern;
+    k.analyzed = true;
+}
+// Discards a swapped-in session whose refactorization did not succeed: its
+// old (session, epoch) must never be live again without committed numerics.
+struct Pf5SwapGuard {
+    KktFactor &k;
+    bool ok = false;
+    ~Pf5SwapGuard() {
+        if (k.swapped_in && !ok) {
+            pf5_carry(k, k.factor, +1);
+            k.factor = hven::linear::SymmetricFactor(k.opts);
+            k.analyzed = false;
+            k.analyzed_pattern = 0;
+            ++pf5_stats().discards;
+        }
+        k.swapped_in = false;
+    }
+};
