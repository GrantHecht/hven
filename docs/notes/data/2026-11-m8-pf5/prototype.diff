+double pf5_v_maxrel = 0.0;
+struct Pf5VerifyReport {
+    ~Pf5VerifyReport() {
+        if (std::getenv("HVEN_PF5_VERIFY") != nullptr) {
+            std::fprintf(stderr,
+                         "PF5V identical=%llu differ=%llu inertia_differ=%llu skipped=%llu max_rel=%.3e\n",
+                         (unsigned long long)pf5_v_same, (unsigned long long)pf5_v_diff,
+                         (unsigned long long)pf5_v_inertia_diff, (unsigned long long)pf5_v_skipped,
+                         pf5_v_maxrel);
+        }
+    }
+} pf5_verify_report;
+// On a retained-session hit: a fresh analysis + factorization of the same K
+// on a throwaway factor, and one solve through each, compared bitwise.
+void pf5_verify(const KktFactor &k, const SpMatRM &K, const hven::linear::FactorizeOutcome &o) {
+    static const bool on = std::getenv("HVEN_PF5_VERIFY") != nullptr;
+    if (!on || !k.swapped_in) {
+        return;
+    }
+    hven::linear::SymmetricFactor::Options opts = k.opts;
+    opts.threads = k.factor.threads();
+    hven::linear::SymmetricFactor f(opts);
+    f.analyze(K);
+    const hven::linear::FactorizeOutcome fo = f.factorize(K);
+    if (fo.status != o.status || fo.arm != o.arm ||
+        fo.inertia.positive != o.inertia.positive || fo.inertia.negative != o.inertia.negative ||
+        fo.inertia.perturbed_pivots != o.inertia.perturbed_pivots) {
+        ++pf5_v_inertia_diff;
+    }
+    if (fo.status != hven::linear::FactorizeOutcome::Status::kOk ||
+        o.status != hven::linear::FactorizeOutcome::Status::kOk) {
+        ++pf5_v_skipped;
+        return;
+    }
+    const Index n = K.rows();
+    Vec b(n);
+    for (Index i = 0; i < n; ++i) {
+        b(i) = 1.0 + static_cast<double>(i % 7) / 7.0;
+    }
+    Vec x1(n), x2(n);
+    k.factor.solve(b, x1);
+    f.solve(b, x2);
+    bool same = true;
+    for (Index i = 0; i < n; ++i) {
+        if (std::memcmp(&x1(i), &x2(i), sizeof(double)) != 0) {
+            same = false;
+            const double den = std::max(std::abs(x2(i)), 1e-300);
+            pf5_v_maxrel = std::max(pf5_v_maxrel, std::abs(x1(i) - x2(i)) / den);
+        }
+    }
+    same ? ++pf5_v_same : ++pf5_v_diff;
+}
