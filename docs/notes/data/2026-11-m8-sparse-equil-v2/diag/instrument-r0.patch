+                     "etaD raw0=%.2e raw2=%.2e dkd0=%.2e dkd1=%.2e | etaK raw0=%.2e raw2=%.2e "
+                     "dkd0=%.2e dkd1=%.2e | eigK %d/%d/%d min=%.2e max=%.2e | eigDKD %d/%d/%d "
+                     "min=%.2e max=%.2e | dmin=%.2e dmax=%.2e\n",
+                     (long)K.rows(), (long)k.seq_raw_pert, (long)outcome.inertia.positive,
+                     (long)outcome.inertia.negative,
+                     (long)so.inertia.perturbed_pivots.value_or(-1), (long)so.inertia.positive,
+                     (long)so.inertia.negative, raw0, raw2, dkd0, dkd1, raw0K, raw2K, dkd0K, dkd1K,
