+        double dkd0 = 0, dkd0K = 0;
+        const double dkd1 = seq_eta_refined(K, b, &d, dkd_solve, 1, &dkd0);
+        const double dkd1K = seq_eta_refined(K, b, nullptr, dkd_solve, 1, &dkd0K);
