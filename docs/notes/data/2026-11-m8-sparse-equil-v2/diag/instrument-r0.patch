+namespace {
+SpMatRM seq_congruent(const SpMatRM &K, const Vec &d) {
+    SpMatRM KD = K;
+    for (Index i = 0; i < static_cast<Index>(K.rows()); ++i) {
+        for (SpMatRM::InnerIterator e(KD, i); e; ++e) {
+            e.valueRef() *= d(i) * d(static_cast<Index>(e.col()));
+        }
+    }
+    return KD;
+}
+Vec seq_probe_rhs(const SpMatRM &K, const Vec &d) {
+    const auto n = static_cast<Index>(d.size());
+    Vec u(n);
+    std::uint32_t state = 0x9E3779B9u;
+    for (Index i = 0; i < n; ++i) {
+        state = state * 1664525u + 1013904223u;
+        u(i) = (2.0 * (static_cast<double>(state >> 8) / 16777216.0) - 1.0) * d(i);
+    }
+    return K.template selfadjointView<Eigen::Upper>() * u;
+}
+template <typename S>
+double seq_eta_refined(const SpMatRM &K, const Vec &b, const Vec *d, S &&solve, int steps,
+                       double *eta0) {
+    Vec y = solve(b), r, acc;
+    const double kn = symmetric_inf_norm(K, d, acc);
+    double eta = dense_backward_error(K, kn, b, y, r, d);
+    if (eta0) *eta0 = eta;
+    for (int s = 0; s < steps; ++s) {
+        Vec c = y - solve(r);
+        Vec rc;
+        const double ce = dense_backward_error(K, kn, b, c, rc, d);
+        if (!(ce < eta)) break;
+        y = c; r = rc; eta = ce;
+    }
+    return eta;
+}
+void seq_spectrum(const SpMatRM &K, const Vec *d, int &pos, int &neg, int &zer, double &minabs,
+                  double &maxabs) {
+    Eigen::MatrixXd A = Eigen::MatrixXd(SpMatRM(K.template selfadjointView<Eigen::Upper>()));
+    if (d) A = d->asDiagonal() * A * d->asDiagonal();
+    Eigen::SelfAdjointEigenSolver<Eigen::MatrixXd> es(A, Eigen::EigenvaluesOnly);
+    const Vec ev = es.eigenvalues();
+    maxabs = ev.cwiseAbs().maxCoeff();
+    minabs = ev.cwiseAbs().minCoeff();
+    const double tol = 1e-10 * maxabs;
+    pos = neg = zer = 0;
+    for (Index i = 0; i < ev.size(); ++i) {
+        if (std::abs(ev(i)) <= tol) ++zer; else if (ev(i) > 0) ++pos; else ++neg;
+    }
+}
