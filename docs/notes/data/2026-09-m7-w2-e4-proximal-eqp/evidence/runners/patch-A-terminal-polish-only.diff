+
+bool QpEngine::polish_footprint_open(const QpProblem &qp, const WorkingSet &ws, const Vec &x,
+                                    const Vec &ai_row_norm1, const Vec &lambda_i,
+                                    const Vec &ae_row_norm1, const Vec &lambda_e, const Vec &z,
+                                    const QpOptions &opts) const {
+    // (a) the DUAL footprint: a working row whose dual_mu*|lambda| is above its
+    // own tolerance, which is exactly mu_footprint_open's question and the term
+    // the complementarity product squares.
+    if (opts.dual_mu > 0.0 &&
+        mu_footprint_open(qp, ws, x, ai_row_norm1, lambda_i, ae_row_norm1, lambda_e, opts)) {
+        return true;
+    }
+    const TerminalKkt now = terminal_kkt(qp, ws, x, lambda_e, lambda_i, z);
+    // (b) the PRIMAL footprint in the stationarity residual: the KKT-point test
+    // admits opt_tol * scale, and the O(primal_delta) bias of the proximal answer
+    // is what usually sits there. NaN is "open" -- the polish is the branch that
+    // can tell a bad answer from a good one, and its acceptance test refuses a
+    // non-finite candidate anyway.
+    if (!(now.stationarity <= detail::kTerminalPolishStatFrac * opts.opt_tol)) {
+        return true;
+    }
+    // (c) the complementarity product itself, against the row tolerance it is
+    // measured in.
+    return !(now.complementarity <= opts.feas_tol);
+}
+
+bool QpEngine::polish_terminal_point(const QpProblem &qp, const WorkingSet &ws, Vec &x,
+                                     Vec &lambda_e, Vec &lambda_i, Vec &z, QpCounters &counters,
+                                     const QpOptions &opts) const {
+    ++counters.terminal_polish_solves;
+    QpOptions o = opts;
+    o.dual_mu = 0.0;
+
+    // The mu-free EQP of the FINAL face, in a LOCAL factor and a LOCAL face:
+    // the pass's own factor and border stack are untouched, and the answer is
+    // the bound-ELIMINATED one on both algebras, so the polished point a border
+    // solve reports and the one a refactorize solve reports come out of the same
+    // system.
+    detail::KktFactor local(threads_);
+    EliminatedFace local_face;
+    detail::InertiaVerdict v = detail::InertiaVerdict::kWrong;
+    EqpResult r;
+    try {
+        r = eliminated_candidate(qp, ws, x, local, local_face, counters, v, o);
+    } catch (const std::runtime_error &) {
+        ++counters.terminal_polish_rejected;
+        return false; // no mu-free solve: the walk's own point stands
+    }
+    // AND THE PRIMAL DELTA BACKED OUT OF THE ANSWER, which is consistent exactly
+    // here: at a terminal point the step is going to zero, so the proximal
+    // penalty's own term delta*(x - x_k) is going to zero with it and the face's
+    // unregularized KKT system is the one the point should satisfy.
+    if (local_face.factorized) {
+        (void)polish_eqp_unregularized(qp, ws, local, o, detail::kTerminalPolishSteps, r);
+    }
+    if (r.x.size() != qp.n() || !r.x.allFinite() || !r.lambda_e.allFinite() ||
+        !r.lambda_w.allFinite()) {
+        ++counters.terminal_polish_rejected;
+        return false;
+    }
+
+    Vec cand_le = Vec::Zero(qp.me());
+    Vec cand_li = Vec::Zero(qp.mi());
+    Vec cand_z = Vec::Zero(qp.n());
+    price(qp, ws, r, cand_le, cand_li, cand_z);
+
+    const TerminalKkt before = terminal_kkt(qp, ws, x, lambda_e, lambda_i, z);
+    const TerminalKkt after = terminal_kkt(qp, ws, r.x, cand_le, cand_li, cand_z);
+
+    // ACCEPTANCE. Written as a chain of !(good) tests so a NaN anywhere rejects.
+    const bool feasible =
+        after.rows <= std::max(opts.feas_tol, before.rows); // keeps feasibility
+    const bool no_worse = after.stationarity <= before.stationarity && after.rows <= before.rows &&
+                          after.complementarity <= before.complementarity;
+    const bool strictly_better = after.stationarity < before.stationarity ||
+                                 after.rows < before.rows ||
+                                 after.complementarity < before.complementarity;
+    if (!after.all_finite() || !feasible || !no_worse || !strictly_better) {
+        ++counters.terminal_polish_rejected;
+        return false;
+    }
+    x = r.x;
+    lambda_e = std::move(cand_le);
+    lambda_i = std::move(cand_li);
+    z = std::move(cand_z);
+    return true;
+}
