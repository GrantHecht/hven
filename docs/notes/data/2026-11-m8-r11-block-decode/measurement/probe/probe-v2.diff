+// R11 SCRATCH PROBE -- never committed. Counts where block_evidence()'s old
+// (trace +- disc)/2 decode and the det/trace decode disagree, and where the
+// Schur stack's decisions would differ.
+#pragma once
+#include <atomic>
+#include <optional>
+#include "hven/linear/dense_symmetric_factor.h"
+
+namespace hven::linear::r11 {
+#define R11_COUNTERS(X)                                                                            \
+    X(be_calls) X(be_blocks1) X(be_blocks2) X(be_nonfinite_calls) X(be_det_zero_blocks)            \
+    X(be_sign_disagree_blocks) X(be_neg_disagree_calls) X(be_mag_diff_blocks)                      \
+    X(be_old_small_zero_blocks) X(be_old_e2_wrongsign_blocks) X(sc_neg_reads)                     \
+    X(sc_neg_read_disagree) X(sc_nr_calls) X(sc_nr_disagree) X(sc_ns_calls) X(sc_ns_disagree)     \
+    X(sc_cond_calls) X(sc_cond_bits_differ) X(sc_cond_maxside_disagree) X(latch_calls)            \
+    X(latch_mild_disagree) X(sc_nnd_calls) X(sc_nnd_disagree)
+#define R11_HIT(name) do { ++(name); ::hven::linear::r11::snapshot("hit:" #name); } while (0)
+#define R11_DECL(name) inline std::atomic<long> name{0};
+R11_COUNTERS(R11_DECL)
+#undef R11_DECL
+void snapshot(const char *tag);
+void maybe_snapshot();
+// The det/trace evidence of the most recent block_evidence() call on this thread.
+inline thread_local std::optional<BunchKaufmanBlockEvidence> last_alt;
+} // namespace hven::linear::r11
