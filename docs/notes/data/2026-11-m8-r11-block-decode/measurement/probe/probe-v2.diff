+bool decode2(double a11, double a21, double a22, Dec &out) {
+    if (!std::isfinite(a11) || !std::isfinite(a21) || !std::isfinite(a22)) return false;
+    const double m = std::max({std::abs(a11), std::abs(a21), std::abs(a22)});
+    if (m == 0.0) { out = {0.0, 0.0, 0}; return true; }
+    int e = 0; (void)std::frexp(m, &e);
+    const double b11 = std::ldexp(a11, -e), b21 = std::ldexp(a21, -e), b22 = std::ldexp(a22, -e);
