+    const double err = std::fma(-b21, b21, w);
+    const double det = std::fma(b11, b22, -w) + err;
+    const double ht = 0.5 * (b11 + b22), hd = 0.5 * (b11 - b22);
+    const double r = std::sqrt(std::fma(hd, hd, w));
+    const double big = std::abs(ht) + r;
+    const double small = big > 0.0 ? std::abs(det) / big : 0.0;
+    const double B = std::ldexp(big, e), S = std::ldexp(small, e);
+    if (ht >= 0.0) { out.abs1 = B; out.abs2 = S; } else { out.abs1 = S; out.abs2 = B; }
