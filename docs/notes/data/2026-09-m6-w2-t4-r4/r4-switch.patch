+// TEMP-T4-R4 (measurement harness; not shipped)
+namespace {
+void t4_cell(const char *fixture, QpMode mode, NlpModel &m, const SqpOptions &base) {
+    SqpOptions opts = base;
+    opts.qp_mode = mode;
+    SqpDriver driver(opts);
+    const SqpSolution sol = driver.solve(m);
+#ifdef NDEBUG
+    const char *cfg = "release";
+#else
+    const char *cfg = "debug";
+#endif
+    const char *arm = std::getenv("HVEN_T4_OFF") != nullptr ? "off" : "on";
+    std::fprintf(stderr, "T4CELL,%s,%s,%s,%s,%d,%d,%lld,%lld,%lld,%lld,%lld,%lld\n", fixture, cfg,
+                 seed_mode_name(mode), arm, static_cast<int>(sol.status),
+                 sol.infeasibility_certified ? 1 : 0,
+                 static_cast<long long>(sol.counters.restoration_iters),
+                 static_cast<long long>(sol.counters.factorizations),
+                 static_cast<long long>(sol.counters.major_iters),
+                 static_cast<long long>(sol.counters.evals_full),
+                 static_cast<long long>(sol.counters.evals_values),
+                 static_cast<long long>(sol.counters.qp_minor_iters));
+}
+} // namespace
+
+TEST(SqpT4R4, Table) {
+    for (const QpMode mode : kSeedModes) {
+        {
+            BoxBlockedEqualityModel m;
+            SqpOptions o;
+            t4_cell("box_blocked_eq", mode, m, o);
+        }
+        {
+            CircleInequalityModel m;
+            SqpOptions o;
+            t4_cell("circle_ineq", mode, m, o);
+        }
+        {
+            InfeasibleCircleLineModel m;
+            SqpOptions o;
+            o.max_iter = 200;
+            o.qp.ws_algebra = WorkingSetLinearAlgebra::kSchurBorder;
+            t4_cell("circle_line_border", mode, m, o);
+        }
+        {
+            InfeasibleCircleLineModel m;
+            SqpOptions o;
+            o.max_iter = 200;
+            o.qp.ws_algebra = WorkingSetLinearAlgebra::kRefactorize;
+            t4_cell("circle_line_refac", mode, m, o);
+        }
+        {
+            InfeasibleCircleLineModel m(1.0, 0.0);
+            SqpOptions o;
+            o.tr_min = 1e-2;
+            t4_cell("floor_1e-2", mode, m, o);
+        }
+        {
+            InfeasibleCircleLineModel m(1.0, 0.0);
+            SqpOptions o;
+            o.tr_min = 1e-5;
+            t4_cell("floor_1e-5", mode, m, o);
+        }
+        {
+            InfeasibleCircleLineModel m(2.0, 1.999999);
+            SqpOptions o;
+            o.max_iter = 200;
+            t4_cell("circle_line_asym", mode, m, o);
+        }
+        {
+            InfeasibleCircleLineModel m(2.0, 1.999999);
+            SqpOptions o;
+            o.max_iter = 200;
+            o.enable_scaling = true;
+            t4_cell("circle_line_asym_scaled", mode, m, o);
+        }
+        {
+            BoxWatchingSpreadModel m;
+            SqpOptions o;
+            o.max_iter = 60;
+            o.enable_scaling = true;
+            t4_cell("row_spread_scaled", mode, m, o);
+        }
+        for (const int number : {10, 11, 15}) {
+            const HsProblem p = make_hs(number);
+            SqpOptions o;
+            t4_cell(fmt::format("hs{}", number).c_str(), mode, *p.model, o);
+        }
+        {
+            RunawayValleyModel m;
+            SqpOptions o;
+            o.tr_init = 8.0;
+            o.max_iter = 60;
+            t4_cell("runaway_valley", mode, m, o);
+        }
+        {
+            StalledValleyModel m;
+            SqpOptions o;
+            o.tr_init = 8.0;
+            o.max_iter = 60;
+            t4_cell("stalled_valley", mode, m, o);
+        }
+    }
