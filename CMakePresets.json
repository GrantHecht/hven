{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 24,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "linux-clang-release",
            "displayName": "Linux Clang Release",
            "description": "Release build using system LLVM Clang on Linux",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "installDir": "${sourceDir}/build/install/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE",
                "HVEN_FP_MODE": "SAFER_FAST",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++"
            }
        },
        {
            "name": "linux-clang-debug",
            "displayName": "Linux Clang Debug",
            "description": "Debug build using system LLVM Clang on Linux",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-debug",
            "installDir": "${sourceDir}/build-debug/install/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE",
                "HVEN_FP_MODE": "SAFER_FAST",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++"
            }
        },
        {
            "name": "linux-clang-coverage",
            "displayName": "Linux Clang Coverage",
            "description": "Debug-based build with LLVM source-based coverage instrumentation (-fprofile-instr-generate -fcoverage-mapping). INSTRUMENT TREE ONLY: never a source of quotable timings, pins, or baselines -- coverage flags change codegen, so nothing measured here is comparable to the uniform flag regime. Debug base keeps Eigen's runtime asserts active so covered paths are also checked paths. Reports via scripts/run_coverage.sh (llvm-profdata + llvm-cov).",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-coverage",
            "installDir": "${sourceDir}/build-coverage/install/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE",
                "HVEN_FP_MODE": "SAFER_FAST",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
                "CMAKE_CXX_FLAGS": "-fprofile-instr-generate -fcoverage-mapping",
                "CMAKE_EXE_LINKER_FLAGS": "-fprofile-instr-generate"
            }
        },
        {
            "name": "macos-clang-release",
            "displayName": "macOS Clang Release (AppleClang, CI)",
            "description": "Release build using the Xcode Command Line Tools' AppleClang on macOS (Apple Silicon). Written for the macos-clang-release CI lane -- AppleClang is preferred over Homebrew LLVM for this lane because it needs no extra brew formula and is what a from-scratch Mac checkout has by default; CMAKE_CXX_COMPILER is intentionally left unset so CMake picks up whatever `clang++` the runner's `xcode-select` resolves to. Accelerate is a system framework, not a package -- cmake/FindAccelerateSparse.cmake finds it via the SDK's default framework search path, no extra install step needed. OBSERVED: this preset configured, built and ran green on GitHub's macos-26-arm64 runner in CI run 31287205323 (commit ca2744c1ba41), 51 tests: 49 passed, 2 skipped by design, 0 failed -- see docs/ci.md.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-macos",
            "installDir": "${sourceDir}/build-macos/install/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE",
                "HVEN_FP_MODE": "SAFER_FAST"
            }
        },
        {
            "name": "windows-clang-release",
            "displayName": "Windows Clang Release (clang-cl, CI)",
            "description": "Release build using the LLVM/clang-cl toolchain preinstalled on GitHub's windows-latest runner. Compiler paths and the architecture/toolset block are the x64-Clang-Release preset from tycho's CMakePresets.json (the clang-cl precedent this was written from) verbatim -- same LLVM install location GitHub ships, same generator, same PIE/link setup. Written for the windows-clang-release CI lane; OBSERVED -- it configured, built and ran green on GitHub's windows-latest runner in CI run 31287205323 (commit ca2744c1ba41), 113 tests passed, 0 failed. See docs/ci.md.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-windows",
            "installDir": "${sourceDir}/build-windows/install/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE",
                "HVEN_FP_MODE": "SAFER_FAST",
                "CMAKE_C_COMPILER": "C:/Program Files/LLVM/bin/clang-cl.exe",
                "CMAKE_C_COMPILER_AR": "C:/Program Files/LLVM/bin/llvm-ar.exe",
                "CMAKE_C_COMPILER_RANLIB": "C:/Program Files/LLVM/bin/llvm-ranlib.exe",
                "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang-cl.exe",
                "CMAKE_CXX_COMPILER_AR": "C:/Program Files/LLVM/bin/llvm-ar.exe",
                "CMAKE_CXX_COMPILER_RANLIB": "C:/Program Files/LLVM/bin/llvm-ranlib.exe",
                "CMAKE_LINKER": "C:/Program Files/LLVM/bin/lld-link.exe"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-clang-release",
            "displayName": "Linux Clang Release Build",
            "configurePreset": "linux-clang-release",
            "nativeToolOptions": [
                "-j6",
                "-v"
            ]
        },
        {
            "name": "linux-clang-debug",
            "displayName": "Linux Clang Debug Build",
            "configurePreset": "linux-clang-debug",
            "nativeToolOptions": [
                "-j6",
                "-v"
            ]
        },
        {
            "name": "linux-clang-coverage",
            "configurePreset": "linux-clang-coverage"
        },
        {
            "name": "macos-clang-release",
            "displayName": "macOS Clang Release Build",
            "configurePreset": "macos-clang-release",
            "nativeToolOptions": [
                "-j3",
                "-v"
            ]
        },
        {
            "name": "windows-clang-release",
            "displayName": "Windows Clang Release Build",
            "configurePreset": "windows-clang-release",
            "nativeToolOptions": [
                "-j4",
                "-v"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "linux-clang-release",
            "displayName": "Linux Clang Release Test",
            "configurePreset": "linux-clang-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-clang-debug",
            "displayName": "Linux Clang Debug Test",
            "configurePreset": "linux-clang-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "macos-clang-release",
            "displayName": "macOS Clang Release Test",
            "configurePreset": "macos-clang-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-clang-release",
            "displayName": "Windows Clang Release Test",
            "configurePreset": "windows-clang-release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}