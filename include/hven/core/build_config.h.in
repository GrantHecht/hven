// GENERATED by CMake from include/hven/core/build_config.h.in at configure time. The installed
// copy records what the installed library was built with; edit the .in, not this file.

#pragma once

#include <Eigen/Core>

namespace hven {

/// The value of EIGEN_MAX_ALIGN_BYTES this hven was built with. Eigen derives it from the SIMD
/// instruction set macros in force where <Eigen/Core> is included, so a consumer translation
/// unit compiled with a different ISA than the library disagrees about the layout of
/// fixed-size vectorized types and the alignment of Eigen's heap allocations, which is heap
/// corruption across the archive boundary, not a diagnostic. Linking hven::hven passes the
/// matching definition automatically; a hand-written compile line must pass
/// -DEIGEN_MAX_ALIGN_BYTES=<this value>.
inline constexpr int kBuiltEigenMaxAlignBytes = @HVEN_EIGEN_MAX_ALIGN_BYTES@;

/// The value of EIGEN_MAX_ALIGN_BYTES in the translation unit that includes this header.
inline constexpr int kConsumerEigenMaxAlignBytes = EIGEN_MAX_ALIGN_BYTES;

/// True iff this translation unit agrees with the library about Eigen's alignment.
constexpr bool eigen_alignment_matches() noexcept {
    return kConsumerEigenMaxAlignBytes == kBuiltEigenMaxAlignBytes;
}

} // namespace hven

/// Compile-time guard for consumers: put it at namespace scope in any translation unit that
/// includes hven headers; a mismatched EIGEN_MAX_ALIGN_BYTES then fails to compile instead of
/// corrupting the heap at run time.
#define HVEN_STATIC_ASSERT_EIGEN_ALIGNMENT()                                                       \
    static_assert(::hven::eigen_alignment_matches(),                                               \
                  "EIGEN_MAX_ALIGN_BYTES differs from the value hven was built with "              \
                  "(hven::kBuiltEigenMaxAlignBytes); link hven::hven or pass "                     \
                  "-DEIGEN_MAX_ALIGN_BYTES=<that value>")
